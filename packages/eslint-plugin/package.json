{
  "name": "@jessie.js/eslint-plugin",
  "version": "0.4.3",
  "description": "Jessie-specific ESLint plugin",
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin"
  ],
  "author": "Agoric",
  "main": "lib/index.js",
  "type": "commonjs",
  "scripts": {
    "test": "mocha test/test-*.js",
    "build": "exit 0",
