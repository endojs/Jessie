  "jessie": [
    {
      "name": "Jessie const declaration",
      "block": {
        "type": "jessie_const",
        "fields": {
          "VAR": "x"
        },
        "inputs": {
          "VALUE": {
            "block": {
              "type": "json_number",
              "fields": {
                "VALUE": 42
              }
            }
          }
        }
      },
      "expected": "const x = 42;"
    },
    {
      "name": "Jessie let declaration",
      "block": {
        "type": "jessie_let",
        "fields": {
          "VAR": "count"
        },
        "inputs": {
          "VALUE": {
            "block": {
              "type": "json_number",
              "fields": {
                "VALUE": 0
              }
            }
          }
        }
      },
      "expected": "let count = 0;"
    },
    {
      "name": "Jessie object destructuring",
      "block": {
        "type": "jessie_const_destructure",
        "fields": {
          "PROPS": "a, b"
        },
        "inputs": {
          "VALUE": {
            "block": {
              "type": "justin_variable",
              "fields": {
                "NAME": "obj"
              }
            }
          }
        }
      },
      "expected": "const { a, b } = obj;"
    },
    {
      "name": "Jessie array destructuring",
      "block": {
        "type": "jessie_const_array_destructure",
        "fields": {
          "ITEMS": "x, y"
        },
        "inputs": {
          "VALUE": {
            "block": {
              "type": "justin_variable",
              "fields": {
                "NAME": "arr"
              }
            }
          }
        }
      },
      "expected": "const [ x, y ] = arr;"
    },
    {
      "name": "Jessie arrow function expression",
      "block": {
        "type": "jessie_arrow",
        "fields": {
          "PARAMS": "x"
        },
        "inputs": {
          "EXPR": {
            "block": {
              "type": "justin_variable",
              "fields": {
                "NAME": "x"
              }
            }
          }
        }
      },
      "expected": "(x) => x"
    },
    {
      "name": "Jessie return statement",
      "block": {
        "type": "jessie_return",
        "inputs": {
          "VALUE": {
            "block": {
              "type": "json_number",
              "fields": {
                "VALUE": 10
              }
            }
          }
        }
      },
      "expected": "return 10;"
    },
    {
      "name": "Jessie import statement",
      "block": {
        "type": "jessie_import",
        "fields": {
          "MODULE": "./module.js"
        }
      },
      "expected": "import {} from './module.js';"
    },
    {
      "name": "Jessie harden",
      "block": {
        "type": "jessie_harden",
        "inputs": {
          "VALUE": {
            "block": {
              "type": "json_object"
            }
          }
        }
      },
      "expected": "harden({})"
    },
    {
      "name": "Simple object with arrow functions (origin.getX)",
      "block": {
        "type": "jessie_const",
        "fields": {
          "VAR": "origin"
        },
        "inputs": {
          "VALUE": {
            "block": {
              "type": "json_object"
            }
          }
        }
      },
      "expected": "const origin = {};"
    },
    {
      "name": "Arrow function returning 0",
      "block": {
        "type": "jessie_arrow",
        "fields": {
          "PARAMS": ""
        },
        "inputs": {
          "EXPR": {
            "block": {
              "type": "json_number",
              "fields": {
                "VALUE": 0
              }
            }
          }
        }
      },
      "expected": "() => 0"
