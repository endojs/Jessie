{
  "compilerOptions": {
    "moduleResolution": "bundler",
    "target": "esnext",
    "module": "esnext",
    "checkJs": true,
    "noEmit": true,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "maxNodeModuleJsDepth": 0,
    "paths": {
      "@jessie.js/eslint-plugin": ["./src/shims.d.ts"],
      "@jessie.js/eslint-plugin/lib/use-jessie-rules.js": ["./src/shims.d.ts"]
    }
  },
  "include": ["src", "bin", "test"],
  "exclude": ["node_modules/**"]
}
