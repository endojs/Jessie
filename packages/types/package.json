  "devDependencies": {
    "ava": "^6.4.1",
    "nyc": "^15.1.0",
    "typescript": "^5.9.2"
  },
  "files": [
    "LICENSE*",
    "dist",
    "src",
    "types"
  ],
  "publishConfig": {
    "access": "public"
  },
  "ava": {
    "files": [
      "test/**/test-*.js"
    ],
    "timeout": "2m"
